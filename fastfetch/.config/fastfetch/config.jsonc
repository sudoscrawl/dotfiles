{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "small"
    },

    "display": {
        "separator": "  "
    },

    "modules": [
        "title",
        "separator",

        "os",
        "host",
        "kernel",
        "uptime",

        "packages",
        "shell",
        "terminal",

        "cpu",
        "gpu",
        "memory",

        {
            "type": "disk",
            "folders": [
                "/",
                "/home"
            ],
            "format": "{1}: {2} / {3}" 
        },
        "localip",

        "de",
        "wm",

        "battery",

        "break",
        "colors"
    ]
}
